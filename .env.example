# =============================================================================
# Groundbreak — environment reference
# -----------------------------------------------------------------------------
# Copy to `.env` (local tooling: drizzle-kit, scripts) and to `.dev.vars`
# (Cloudflare Worker local dev via `next dev` / `wrangler dev`).
# In production, set these as Cloudflare secrets:  wrangler secret put NAME
# Never commit real values. Only this .example file is tracked.
# =============================================================================

# --- Core: database (Phase 0+) -----------------------------------------------
# Neon Postgres (PostGIS-enabled). Use the POOLED connection string for the app
# (serverless/edge) and a DIRECT (non-pooled) string for migrations if needed.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Optional: separate direct URL used by drizzle-kit migrate/studio.
DATABASE_URL_UNPOOLED=""

# --- App (Phase 3+) ----------------------------------------------------------
# Public base URL of the app (used for absolute links, share URLs, emails).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Public name of the product (codename until trademark check — see README).
NEXT_PUBLIC_APP_NAME="Groundbreak"

# --- Data sources: permit connectors (Phase 1+) ------------------------------
# Per-jurisdiction portal URLs + dataset ids + field mappings are stored in the
# DB (`permit_datasets`), NOT here — adding a market is data entry, not config.
# These keys are global defaults the connector framework reads.
#
# Geocoding: US Census Geocoder (free; default) resolves addresses lacking coords.
CENSUS_GEOCODER_BASE_URL="https://geocoding.geo.census.gov/geocoder"
GEOCODER_PROVIDER="census"   # "census" (default, free) | "mapbox" | "google" (paid swap)
GEOCODER_API_KEY=""
# Polite rate-limit budget per upstream portal (requests/second) — connectors
# respect this and each portal's ToS so we never trip Socrata/ArcGIS limits.
UPSTREAM_RATE_LIMIT_RPS="4"
# How long ingested permits are served from the DB before a portal re-poll is due
# (the cron cadence per jurisdiction governs the actual refresh). Default 7 days.
PERMIT_CACHE_TTL_SECONDS="604800"

# Optional paid aggregator (Shovels) — the national-coverage fallback. STUBBED
# and DISABLED at launch; we self-ingest launch metros via Socrata to stay cheap
# and independent. Only enable if/when national breadth is worth the per-call cost.
PERMIT_AGGREGATOR_PROVIDER=""   # "" (off) | "shovels"
SHOVELS_API_KEY=""

# --- Auth: Better Auth (Phase 4) ---------------------------------------------
BETTER_AUTH_SECRET="generate-with: openssl rand -base64 32"
BETTER_AUTH_URL="http://localhost:3000"

# --- Email: Resend (Phase 4/6) ----------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Groundbreak <alerts@example.com>"
# Operator address that receives ingestion-health + stale-source alerts (Phase 6.3).
OPERATOR_ALERT_EMAIL="ops@example.com"
# Comma-separated emails allowed into the operator cockpit at /admin (Phase 6.4).
# Falls back to OPERATOR_ALERT_EMAIL when unset.
ADMIN_EMAILS=""

# --- Billing: Stripe (Phase 5) ----------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Price IDs (create monthly + annual in the Stripe dashboard).
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""
STRIPE_PRICE_BUSINESS_MONTHLY=""
STRIPE_PRICE_BUSINESS_ANNUAL=""

# --- Ingestion worker (apps/ingest; Phase 6) ---------------------------------
# Set as Worker secrets/vars on `groundbreak-ingest`: DATABASE_URL, RESEND_API_KEY,
# EMAIL_FROM, OPERATOR_ALERT_EMAIL (shared above), plus:
# Base URL used in alert email links.
APP_URL="http://localhost:3000"
# Optional token guarding the manual POST /run trigger on the ingest worker.
INGEST_TOKEN=""

# --- Cloudflare (deploy; Phase 0 deploy + Phase 6 ingest) --------------------
# Used by `wrangler` for deploys/CI. Local dev does not need these.
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
