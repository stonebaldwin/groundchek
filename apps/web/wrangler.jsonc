{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "groundbreak-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // R2 bucket backing the OpenNext incremental cache (ISR). The binding name
  // `NEXT_INC_CACHE_R2_BUCKET` is what @opennextjs/cloudflare's r2-incremental-cache
  // override reads (see open-next.config.ts).
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "groundbreak-inc-cache",
    },
  ],
  // Secrets (set with `wrangler secret put NAME`): DATABASE_URL, BETTER_AUTH_SECRET.
}
